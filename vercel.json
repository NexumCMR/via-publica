{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/cartel/:codigo",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterestbot|redditbot|vkShare|Embedly|Iframely|Viber).*"
        }
      ],
      "destination": "/api/vista?codigo=:codigo"
    },
    {
      "source": "/disponibles",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterestbot|redditbot|vkShare|Embedly|Iframely|Viber).*"
        }
      ],
      "destination": "/api/vista?portal=1"
    },
    {
      "source": "/cartel/:codigo",
      "destination": "/cartel/index.html"
    },
    {
      "source": "/moni",
      "destination": "/moni/index.html"
    },
    {
      "source": "/disponibles",
      "destination": "/disponibles/index.html"
    },
    {
      "source": "/actualizar",
      "destination": "/actualizar/index.html"
    },
    {
      "source": "/campana/:slug",
      "destination": "/campana/index.html"
    }
  ],
  "headers": [
    {
      "source": "/actualizar",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/fotos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/cartel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    }
  ]
}

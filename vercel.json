{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/cartel/:codigo",
      "destination": "/cartel/index.html"
    },
    {
      "source": "/moni",
      "destination": "/moni/index.html"
    },
    {
      "source": "/disponibles",
      "destination": "/disponibles/index.html"
    },
    {
      "source": "/actualizar",
      "destination": "/actualizar/index.html"
    },
    {
      "source": "/campana/:slug",
      "destination": "/campana/index.html"
    }
  ],
  "headers": [
    {
      "source": "/actualizar",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/cartel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    }
  ]
}